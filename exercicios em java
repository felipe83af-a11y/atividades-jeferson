import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n1 = sc.nextInt();
        int d1 = sc.nextInt();
        int v1 = sc.nextInt();

        int n2 = sc.nextInt();
        int d2 = sc.nextInt();
        int v2 = sc.nextInt();

        if ((double) d1 / v1 < (double) d2 / v2) {
            System.out.println(n1);
        } else {
            System.out.println(n2);
        }

        sc.close();
    }
}
