import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int cibele = sc.nextInt();
        int camila = sc.nextInt();
        int celeste = sc.nextInt();

        if ((cibele < camila && camila < celeste) ||
            (celeste < camila && camila < cibele)) {
            System.out.println(camila);
        } else if ((camila < cibele && cibele < celeste) ||
                   (celeste < cibele && cibele < camila)) {
            System.out.println(cibele);
        } else {
            System.out.println(celeste);
        }

        sc.close();
    }
}

